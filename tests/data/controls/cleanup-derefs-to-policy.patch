+impl<A: Allocator> core::ops::Deref for Cleanup<'_, A> {
+    type Target = A;
+
+    fn deref(&self) -> &A {
+        &*self.policy
+    }
+}
+
+impl<A: Allocator> core::ops::DerefMut for Cleanup<'_, A> {
+    fn deref_mut(&mut self) -> &mut A {
+        &mut *self.policy
+    }
+}
