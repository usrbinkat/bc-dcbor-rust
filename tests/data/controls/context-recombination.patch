+/// Planted: a public document and pending acquisition that pair with any slot.
+pub struct Origin<'c, 's, 'a, A: crate::bounded::Allocator> {
+    document: &'c Document<'a, A::Permit>,
+    pending: &'s mut stable::Pending<A::Origin>,
+}
+
+impl<'c, 's, 'a, A: crate::bounded::Allocator> Origin<'c, 's, 'a, A> {
+    /// Planted: a context of the document's node `index` with any slot.
+    pub fn context<'n, T, S>(self, index: usize, slot: Slot<'s, T, S>) -> Context<'n, 'c, 's, 'a, T, S, A> {
+        Context {
+            document: self.document,
+            index,
+            slot,
+            pending: self.pending,
+            depth: reclamation::Depth::fresh(),
+            bound: false,
+            brand: in_place::Brand::new(),
+        }
+    }
+}
