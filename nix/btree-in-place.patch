+impl<K, V> BTreeMap<K, V> {
+    /// Publish a tree built in fixed-address nodes without moving its entries.
+    ///
+    /// # Safety
+    /// The root and all descendants must form a fully initialized B-tree of
+    /// `height` and exactly `length` entries, with the standard occupancy,
+    /// parent-link, uniform leaf-depth and strict `K::Ord` ordering invariants.
+    /// Every node was allocated by `InPlaceNode::try_allocate`. Ownership of
+    /// every node, key and value transfers to the returned map. Raw handles
+    /// may be retained for later external reclamation but may not be used
+    /// until the map is detached and all references to its contents have ended.
+    /// `None` is valid only with height and length both zero.
+    #[unstable(feature = "btree_in_place", issue = "none")]
+    pub unsafe fn from_in_place(
+        root: Option<&InPlaceNode<K, V>>,
+        height: usize,
+        length: usize,
+    ) -> Self {
+        Self {
+            // SAFETY: the caller establishes the complete tree invariants.
+            root: root.map(|node| unsafe { node.root(height) }),
+            length,
+            alloc: ManuallyDrop::new(Global),
+            _marker: PhantomData,
+        }
+    }
+
+    /// Detach a tree for external, field-by-field reclamation, leaving an
+    /// ordinary empty map. No node is visited and no destructor runs.
+    ///
+    /// # Safety
+    /// The caller retains the raw handles and initialization state of every
+    /// node and entry, and assumes exclusive cleanup responsibility for them.
+    /// No references into the detached tree may remain live.
+    #[unstable(feature = "btree_in_place", issue = "none")]
+    pub unsafe fn detach_in_place(&mut self) {
+        self.root = None;
+        self.length = 0;
+    }
+}
